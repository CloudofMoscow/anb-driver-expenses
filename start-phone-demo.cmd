@echo off
chcp 65001 >nul
cd /d "%~dp0"
title ANB - доступ с телефона

echo =====================================================
echo   ANB - запуск приложения для телефона
echo =====================================================
echo.
echo Если Windows спросит про доступ к сети,
echo разрешите доступ только для частных сетей.
echo.

call npm.cmd run phone

echo.
echo Сервер остановлен. Нажмите любую клавишу, чтобы закрыть окно.
pause >nul
